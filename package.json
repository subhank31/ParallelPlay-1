{
  "name": "minimal-electron-express",
  "version": "1.0.0",
  "description": "Sri Sathya Sai Parallel Playout. Electron control surface with a local AVPlayer helper.",
  "productName": "Parallel Playout",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:player": "swift build -c release --package-path native/PlayoutEngine --arch arm64 --arch x86_64 && mkdir -p native/PlayoutEngine/.build/release && cp native/PlayoutEngine/.build/apple/Products/Release/PlayoutEngine native/PlayoutEngine/.build/release/PlayoutEngine",
    "build:app": "npm run build:player && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --universal",
    "build:dmg": "npm run build:player && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg dir --universal",
    "build:pkg": "npm run build:app && bash scripts/build-pkg.sh",
    "test:player": "node scripts/test-helper.js",
    "test:player:electron": "electron scripts/electron-player-test.js",
    "test:link": "node scripts/test-link.js",
    "test:link:electron": "electron scripts/electron-link-test.js",
    "test:pairing": "node scripts/test-pairing.js",
    "test:clock": "node scripts/test-clock.js",
    "test:pause": "node scripts/test-pause-resume.js",
    "test:clock:electron": "electron scripts/electron-clock-test.js",
    "start:master": "PLAYOUT_ROLE=master electron .",
    "start:slave": "PLAYOUT_ROLE=slave electron ."
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.srisathyasai.parallelplayout",
    "productName": "Parallel Playout",
    "asar": true,
    "npmRebuild": false,
    "afterSign": "scripts/verify-signature.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "player-session.js",
      "player-ipc.js",
      "link-ipc.js",
      "dialog-filters.js",
      "playlist-ui.js",
      "link/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/PlayoutEngine/.build/apple/Products/Release/PlayoutEngine",
        "to": "playout-engine/PlayoutEngine"
      }
    ],
    "extraMetadata": {
      "main": "main.js",
      "dependencies": {}
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Parallel Playout listens for the Master on the local network."
      }
    },
    "dmg": {
      "title": "Parallel Playout",
      "artifactName": "Parallel Playout.dmg"
    }
  }
}
